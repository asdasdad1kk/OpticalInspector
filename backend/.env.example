# Copie este archivo a ".env" (misma carpeta que main.py / el .exe) y ajuste.
# Las rutas relativas se resuelven contra esa carpeta. Se admiten rutas de red:
#   OI_DATA_DIR=\servidor\optical\data

# Carpeta raiz de datos. Todo lo demas cuelga de aqui salvo que se indique otra ruta.
# OI_DATA_DIR=

# Base de datos SQLite (por defecto OI_DATA_DIR\optical_inspector.db)
# OI_DB_PATH=

# Imagenes de inspecciones, piezas patron, sets de validacion y calibracion
# OI_IMAGES_DIR=
# OI_GOLDEN_DIR=
# OI_VALIDATION_DIR=
# OI_CALIBRATION_DIR=

# Respaldos automaticos de la base, logs y archivo de ajustes del panel
# OI_BACKUP_DIR=
# OI_LOG_DIR=
# OI_SETTINGS_FILE=

# Servidor. Use 0.0.0.0 para consultar la app desde otra PC de la red.
# OI_HOST=127.0.0.1
# OI_PORT=8000

# Clave inicial del panel de configuracion (solo se usa la primera vez; luego se
# cambia desde el panel). Si no se define, la clave inicial es "admin".
# OI_CONFIG_PASSWORD=
